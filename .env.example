# ==========================================
# Configurações do Banco Inter
# ==========================================
INTER_CLIENT_ID=seu_inter_client_id
INTER_CLIENT_SECRET=seu_inter_client_secret
INTER_PIX_KEY=sua_chave_pix
INTER_ENV=production # production ou sandbox

# Caminho dos arquivos de certificado mTLS (.crt e .key)
INTER_CERT_PATH=storage/certs/inter_cert.crt
INTER_KEY_PATH=storage/certs/inter_cert.key
INTER_CERT_PASSPHRASE=

# ==========================================
# Configurações da Loja Integrada
# ==========================================
LOJA_INTEGRADA_CHAVE_API=sua_chave_api_loja_20_caracteres
LOJA_INTEGRADA_CHAVE_APLICACAO=sua_chave_aplicacao_ou_cliente_id

# ==========================================
# Configurações da Aplicação
# ==========================================
APP_ENV=development
APP_URL=http://localhost/inter-pix-php
